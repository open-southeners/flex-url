  {
    "name": "removeFilter drops only the targeted attribute",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "status",
          "published"
        ]
      },
      {
        "op": "filter",
        "args": [
          "title",
          "similar"
        ]
      },
      {
        "op": "removeFilter",
        "args": [
          "status"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[title]=similar",
    "reads": [
      {
        "op": "hasFilter",
        "args": [
          "status"
        ],
        "equals": false
      },
      {
        "op": "hasFilter",
        "args": [
          "title"
        ],
        "equals": true
      }
    ]
  },
  {
    "name": "removeFilter with an operator removes only that operator entry",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "due_at",
          "gte",
          "2024-01-01"
        ]
      },
      {
        "op": "filter",
        "args": [
          "due_at",
          "lte",
          "2024-01-31"
        ]
      },
      {
        "op": "removeFilter",
        "args": [
          "due_at",
          "gte"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[due_at][lte]=2024-01-31",
    "reads": [
      {
        "op": "hasFilter",
        "args": [
          "due_at",
          "gte"
        ],
        "equals": false
      },
      {
        "op": "hasFilter",
        "args": [
          "due_at",
          "lte"
        ],
        "equals": true
      }
    ]
  },
