[
  {
    "name": "filter with a single value",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "status",
          "published"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[status]=published",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "status"
        ],
        "equals": "published"
      },
      {
        "op": "hasFilter",
        "args": [
          "status"
        ],
        "equals": true
      }
    ]
  },
  {
    "name": "filter with multiple values comma-joins raw",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "status",
          [
            "published",
            "draft"
          ]
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[status]=published,draft",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "status"
        ],
        "equals": [
          "published",
          "draft"
        ]
      }
    ]
  },
  {
    "name": "filter with explicit \"equal\" operator emits the canonical wire key",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "title",
          "equal",
          "Hello World"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[title][equal]=Hello%20World",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "title",
          "equal"
        ],
        "equals": "Hello World"
      }
    ]
  },
  {
    "name": "filter accepts \"eq\" as an alias for \"equal\" on the wire",
    "base": "https://api.example.com/posts",
    "build": [
      {
        "op": "filter",
        "args": [
          "title",
          "eq",
          "Hello World"
        ]
      }
    ],
    "url": "https://api.example.com/posts?filter[title][equal]=Hello%20World",
    "reads": [
      {
        "op": "getFilter",
        "args": [
          "title",
          "eq"
        ],
        "equals": "Hello World"
      },
      {
        "op": "getFilter",
        "args": [
          "title",
          "equal"
        ],
        "equals": "Hello World"
      }
    ]
  },
  {
    "name": "filter with gt/lt operators",
