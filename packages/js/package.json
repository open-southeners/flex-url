{
  "name": "flex-url",
  "version": "2.1.0",
  "description": "Zero-dependency URL builder/parser for the apiable request grammar",
  "homepage": "https://github.com/open-southeners/flex-url#readme",
  "bugs": {
    "url": "https://github.com/open-southeners/flex-url/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-southeners/flex-url.git",
    "directory": "packages/js"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./links": {
      "import": {
        "types": "./dist/links.d.ts",
        "default": "./dist/links.js"
      },
      "require": {
        "types": "./dist/links.d.cts",
        "default": "./dist/links.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "links": [
        "dist/links.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.loose.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
