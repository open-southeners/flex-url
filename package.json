{
  "name": "flex-url",
  "private": true,
  "description": "Zero-dependency URL builder/parser for the apiable request grammar (JS + PHP mirror)",
  "homepage": "https://flex-url.opensoutheners.com",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
